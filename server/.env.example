# Postgres, per docs/DEPLOY.md — the schema was switched from SQLite to
# Postgres for deployment, so this needs a real Postgres server even for
# local dev now (e.g. a free Render Postgres instance's External Database
# URL, or any local Postgres).
DATABASE_URL="postgresql://user:password@host:5432/dbname"
PORT=4000
JWT_SECRET="replace-with-a-long-random-string"

# Optional. Unset (the default) allows any origin — fine for local dev.
# In production, set this to your deployed client's exact origin, e.g.
# CORS_ORIGIN="https://pathway-for-studies.vercel.app"
CORS_ORIGIN=

# Optional. Defaults to "python" on PATH. Only needed if your interpreter
# has a different name (e.g. "python3") or isn't on PATH.
PYTHON_BIN=
